# Portalia V01 - backend environment
NODE_ENV=development
PORT=3101
LOG_LEVEL=info

# PostgreSQL - usado para migrations (papel owner/superuser)
DATABASE_URL=postgresql://portalia:portalia@localhost:5432/portalia?schema=public

# PostgreSQL - usado pela aplicação em runtime (papel restrito, sem
# SUPERUSER/BYPASSRLS, para que as políticas de Row-Level Security tenham
# efeito). Provisionado por prisma/provisioning/create-app-role.sql.
APP_DATABASE_URL=postgresql://portalia_app:change-me@localhost:5432/portalia?schema=public

# JWT - gere um segredo forte por ambiente (ex.: openssl rand -hex 32).
# Refresh tokens são opacos/hasheados, não JWT, então não têm segredo próprio.
JWT_ACCESS_SECRET=change-me-32-chars-minimum-access-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Bootstrap do primeiro Super Admin (usado apenas na primeira execução do seed/bootstrap).
# Gere uma senha forte antes de usar em qualquer ambiente real. Nunca versione valores reais.
SUPER_ADMIN_BOOTSTRAP_EMAIL=admin@example.com
SUPER_ADMIN_BOOTSTRAP_PASSWORD=change-me-strong-password

# Telefonia - segredo do webhook de eventos AMI/ARI (ex.: openssl rand -hex 32).
# Nenhum Asterisk real está conectado na V01; isso autentica a futura ponte.
TELEPHONY_WEBHOOK_SECRET=change-me-32-chars-minimum-webhook-secret
# Chave AES-256-GCM (32 bytes em hex = 64 caracteres) para cifrar senhas SIP
# em repouso. Gere com: openssl rand -hex 32
TELEPHONY_SIP_SECRET_KEY=change-me-64-hex-chars-0000000000000000000000000000000000

# Origem do frontend Next.js (CORS com credenciais — precisa ser exata, sem wildcard).
FRONTEND_URL=http://localhost:3000

# Armazenamento de fotos operacionais (interface de object store; troque por MinIO/S3 depois).
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=8

# Validade da credencial de retirada (código + QR) apresentada na portaria.
PICKUP_CREDENTIAL_TTL_HOURS=48
# Chave HMAC dedicada para hashear a credencial de retirada — separada de
# JWT_ACCESS_SECRET de propósito (ex.: openssl rand -hex 32).
PICKUP_CREDENTIAL_SECRET=change-me-32-chars-minimum-pickup-secret

# Ponte Go + whatsmeow. Sem estas duas variáveis o adapter permanece um stub
# honesto (relata "não configurada" em vez de fingir envio).
# WHATSAPP_SERVICE_URL=http://localhost:8080
# WHATSAPP_SERVICE_SECRET=change-me-32-chars-minimum-secret
